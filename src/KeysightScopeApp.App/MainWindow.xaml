<Window x:Class="KeysightScopeApp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Keysight 示波器助手 | C# 版" Width="1500" Height="920"
        MinWidth="1280" MinHeight="720">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadCsvCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportCsvCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshResourcesCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding OpenWaveformCommand}"/>
    </Window.InputBindings>
    <DockPanel Background="{DynamicResource BackgroundBrush}">
        <!-- Instrument header -->
        <Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource ScreenBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="SIGNAL LAB · QUANTUM X1" Style="{DynamicResource MonoText}"
                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="采集 · 分析 · 验证 · 归档"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VisaRuntimeMessage}" Foreground="{DynamicResource MutedTextBrush}"
                               MaxWidth="330" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Text="  ◉" Foreground="{DynamicResource GreenBrush}" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Height="32">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Status}" Style="{DynamicResource MonoText}" FontSize="11"
                               AutomationProperties.Name="应用状态"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right" Width="300">
                <ProgressBar x:Name="ProgressIndicator" x:FieldModifier="public" Minimum="0" Maximum="100"
                             Value="{Binding Progress, Mode=OneWay}" Height="8"
                             AutomationProperties.Name="任务进度"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="版本 2.0.0" Style="{DynamicResource MonoText}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="WorkspaceTabs" Background="{DynamicResource BackgroundBrush}"
                    SelectionChanged="WorkspaceTabs_SelectionChanged">
          <TabItem Header="控制台">
           <Grid Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Control dock -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="▣  控制中心" Style="{DynamicResource SectionLabel}"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                        <Border Style="{DynamicResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="●  连接状态" Style="{DynamicResource SectionLabel}"
                                           Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="主设备 01" Style="{DynamicResource MonoText}"
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding DeviceIdentity}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="⌁  设备资源" Style="{DynamicResource SectionLabel}"
                                           Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="资源地址" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox IsEditable="True" ItemsSource="{Binding VisaResources}"
                                          Text="{Binding SelectedResource, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="VISA 资源地址" MinHeight="36" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button Content="连接" Command="{Binding ConnectCommand}" MinHeight="36" Margin="0,4,4,4"/>
                                    <Button Grid.Column="1" Content="断开" Command="{Binding DisconnectCommand}" MinHeight="36" Margin="4"/>
                                </Grid>
                                <Button Content="刷新资源" Command="{Binding RefreshResourcesCommand}"
                                        MinHeight="36" Margin="0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button Content="隐藏资源" Command="{Binding HideResourceCommand}" MinHeight="36" Margin="0,4,4,0"/>
                                    <Button Grid.Column="1" Content="恢复隐藏" Command="{Binding RestoreResourcesCommand}" MinHeight="36" Margin="4,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{DynamicResource CardPanel}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="▣  截图工具" Style="{DynamicResource SectionLabel}"
                                       Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="截图前缀" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ScreenshotPrefix, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36" Margin="0,0,0,8"/>
                            <Button Content="截图并复制" Command="{Binding QuickScreenshotCommand}"
                                    Style="{DynamicResource PrimaryButton}" MinHeight="36" Margin="0,4"/>
                            <Button Content="另存设备截图" Command="{Binding DeviceScreenshotCommand}"
                                    MinHeight="36" Margin="0,4,0,0"/>
                            <Separator Margin="0,12,0,10"/>
                            <TextBlock Text="↥  示波器参考波形" Style="{DynamicResource SectionLabel}"
                                       Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <ComboBox SelectedValue="{Binding ReferenceSource}" SelectedValuePath="Tag"
                                          MinHeight="36" Margin="0,0,4,0" AutomationProperties.Name="参考波形源通道">
                                    <ComboBoxItem Content="CH1" Tag="CHANnel1"/><ComboBoxItem Content="CH2" Tag="CHANnel2"/>
                                    <ComboBoxItem Content="CH3" Tag="CHANnel3"/><ComboBoxItem Content="CH4" Tag="CHANnel4"/>
                                </ComboBox>
                                <ComboBox Grid.Column="1" SelectedValue="{Binding ReferenceSlot}" SelectedValuePath="Tag"
                                          MinHeight="36" Margin="4,0,0,0" AutomationProperties.Name="参考波形位置">
                                    <ComboBoxItem Content="REF1" Tag="1"/><ComboBoxItem Content="REF2" Tag="2"/>
                                </ComboBox>
                            </Grid>
                            <Button Content="当前通道复制到参考波形"
                                    Command="{Binding SaveChannelToReferenceCommand}" MinHeight="36" Margin="0,4"/>
                            <TextBox Text="{Binding ReferenceFileName, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="36" Margin="0,4" AutomationProperties.Name="参考波形文件名"/>
                            <Button Content="保存 H5 到示波器存储"
                                    Command="{Binding SaveReferenceFileCommand}" MinHeight="36" Margin="0,4"/>
                            <Button Content="上传 Keysight H5 到参考波形"
                                    Command="{Binding UploadReferenceFileCommand}" MinHeight="36" Margin="0,4,0,0"/>
                            <TextBlock Text="历史 CSV 需先转换为 Keysight .h5；设备不直接接受 CSV。"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{DynamicResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="▶  快捷操作" Style="{DynamicResource SectionLabel}"
                                       Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,8"/>
                            <Button Content="{Binding RunStopText}" Command="{Binding RunStopCommand}"
                                    Style="{DynamicResource PrimaryButton}" Height="40" Margin="0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="载入 CSV" Command="{Binding LoadCsvCommand}" MinHeight="36" Margin="0,4,4,0"/>
                                <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" MinHeight="36" Margin="4,4,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Border>

            <!-- Dashboard -->
            <Grid Grid.Column="1" Margin="24,20" Background="{DynamicResource BackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource PanelBorder}" Padding="12">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="◫  采集设置" Style="{DynamicResource SectionLabel}"
                                           Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,14"/>
                                <TextBlock Text="采样类型" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding AcquireType}" SelectedValuePath="Tag"
                                          MinHeight="36" Margin="0,0,0,12">
                                    <ComboBoxItem Content="普通" Tag="NORMal"/><ComboBoxItem Content="平均" Tag="AVERage"/>
                                    <ComboBoxItem Content="高分辨率" Tag="HRESolution"/><ComboBoxItem Content="峰值检测" Tag="PEAK"/>
                                </ComboBox>
                                <TextBlock Text="点数模式" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox SelectedValue="{Binding PointsMode}" SelectedValuePath="Tag"
                                          MinHeight="36" Margin="0">
                                    <ComboBoxItem Content="普通" Tag="NORMal"/><ComboBoxItem Content="最大" Tag="MAXimum"/>
                                    <ComboBoxItem Content="原始" Tag="RAW"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{DynamicResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="☷  采集参数" Style="{DynamicResource SectionLabel}"
                                           Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,14"/>
                                <TextBlock Text="采样点数" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RequestedPoints, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{DynamicResource GreenBrush}" FontFamily="JetBrains Mono, Consolas"
                                         MinHeight="36" Margin="0,0,0,8"/>
                                <TextBlock Text="普通模式使用输入点数；最大/原始模式自动探测设备可用点数"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <CheckBox Content="CH1" IsChecked="{Binding Channel1}"/>
                                    <CheckBox Content="CH2" IsChecked="{Binding Channel2}"/>
                                    <CheckBox Content="CH3" IsChecked="{Binding Channel3}"/>
                                    <CheckBox Content="CH4" IsChecked="{Binding Channel4}"/>
                                </WrapPanel>
                                <CheckBox Content="完整深存储（按当前模式自动探测）"
                                          IsChecked="{Binding FullDeepMemory}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{DynamicResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="▶  采集操作" Style="{DynamicResource SectionLabel}"
                                           Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,10"/>
                                <Grid Margin="0,58,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Button Content="运行" Command="{Binding RunCommand}" Style="{DynamicResource PrimaryButton}"
                                            MinHeight="36" Margin="0,4,4,4"/>
                                    <Button Grid.Column="1" Content="单次" Command="{Binding SingleCommand}"
                                            MinHeight="36" Margin="4"/>
                                    <Button Grid.Row="1" Content="停止" Command="{Binding StopCommand}"
                                            Style="{DynamicResource DangerButton}" MinHeight="36" Margin="0,4,4,4"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="获取波形" Command="{Binding CaptureCommand}"
                                            MinHeight="36" Margin="4"/>
                                    <Button Grid.Row="2" Grid.ColumnSpan="2" Content="应用通道显示"
                                            Command="{Binding ApplyChannelDisplayCommand}" MinHeight="36" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{DynamicResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="●  设备状态" Style="{DynamicResource SectionLabel}"
                                           Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding TriggerStatus}" Style="{DynamicResource ReadoutText}"
                                           Foreground="{DynamicResource GreenBrush}" FontSize="15"/>
                                <TextBlock Text="{Binding AcquisitionStateText, StringFormat=采集：{0}}"
                                           Foreground="{DynamicResource CyanBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding TimebaseMode, StringFormat=时基：{0}}"
                                           Style="{DynamicResource MonoText}" FontSize="11" Margin="0,5,0,8"/>
                                <Button Content="读取状态" Command="{Binding ReadDeviceStatusCommand}"
                                        MinHeight="36" Margin="0,4"/>
                                <Button Content="切换 MAIN / ROLL" Command="{Binding ToggleTimebaseModeCommand}"
                                        MinHeight="36" Margin="0,4"/>
                                <Button Content="读取设备错误" Command="{Binding ReadSystemErrorsCommand}"
                                        MinHeight="36" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{DynamicResource PanelBorder}" Padding="0" Margin="0,0,12,0"
                            Background="{DynamicResource ScreenBrush}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="16,12">
                                <TextBlock Text="实时波形视图" Style="{DynamicResource SectionLabel}"
                                           Foreground="{DynamicResource CyanBrush}"/>
                                <Button Content="打开独立波形分析  ↗" Command="{Binding OpenWaveformCommand}"
                                        HorizontalAlignment="Right" Padding="8,4" MinHeight="28" Margin="0"/>
                            </Grid>
                            <scottPlot:WpfPlot x:Name="PreviewPlot" Grid.Row="1"/>
                            <Border Grid.Row="2" Background="{DynamicResource PanelLowBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,1,0,0"
                                    Padding="12,8">
                                <StackPanel>
                                <TextBlock Text="{Binding WaveformIntegrityStatus}"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="4,0,4,4"/>
                                <ItemsControl ItemsSource="{Binding ChannelSummaries}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelHighBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="4">
                                                <TextBlock Style="{DynamicResource MonoText}" FontSize="11">
                                                    <Run Text="{Binding Channel}"/><Run Text="  峰峰值 "/>
                                                    <Run Text="{Binding Maximum, StringFormat=G5}" Foreground="{DynamicResource CyanBrush}"/>
                                                    <Run Text="  频率 "/><Run Text="{Binding FrequencyHz, StringFormat=G5}" Foreground="{DynamicResource GreenBrush}"/>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <TabControl Grid.Column="1">
                        <TabItem Header="结果">
                            <DataGrid ItemsSource="{Binding ChannelSummaries}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="80"/>
                                    <DataGridTextColumn Header="点数" Binding="{Binding Points, StringFormat=N0}" Width="80"/>
                                    <DataGridTextColumn Header="最小值" Binding="{Binding Minimum, StringFormat=G6}" Width="*"/>
                                    <DataGridTextColumn Header="最大值" Binding="{Binding Maximum, StringFormat=G6}" Width="*"/>
                                    <DataGridTextColumn Header="频率" Binding="{Binding FrequencyHz, StringFormat=G6}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="触发">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16">
                                    <TextBlock Text="触发源" Style="{DynamicResource SectionLabel}"/>
                                    <ComboBox SelectedValue="{Binding TriggerSource}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="CH1" Tag="CHANnel1"/><ComboBoxItem Content="CH2" Tag="CHANnel2"/>
                                        <ComboBoxItem Content="CH3" Tag="CHANnel3"/><ComboBoxItem Content="CH4" Tag="CHANnel4"/>
                                    </ComboBox>
                                    <TextBlock Text="边沿方向" Style="{DynamicResource SectionLabel}"/>
                                    <ComboBox SelectedValue="{Binding TriggerSlope}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="上升沿" Tag="POSitive"/><ComboBoxItem Content="下降沿" Tag="NEGative"/>
                                        <ComboBoxItem Content="任一边沿" Tag="EITHer"/><ComboBoxItem Content="交替边沿" Tag="ALTernate"/>
                                    </ComboBox>
                                    <TextBlock Text="触发电平" Style="{DynamicResource SectionLabel}"/>
                                    <TextBox Text="{Binding TriggerLevel, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="扫描模式" Style="{DynamicResource SectionLabel}"/>
                                    <ComboBox SelectedValue="{Binding TriggerSweep}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="自动" Tag="AUTO"/><ComboBoxItem Content="普通" Tag="NORMal"/>
                                    </ComboBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Content="读取" Command="{Binding ReadTriggerCommand}" Margin="0,4,4,4"/>
                                        <Button Grid.Column="1" Content="应用" Command="{Binding ApplyTriggerCommand}"
                                                Style="{DynamicResource PrimaryButton}" Margin="4"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="通道设置">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16">
                                    <TextBlock Text="垂直通道" Style="{DynamicResource SectionLabel}"/>
                                    <ComboBox SelectedValue="{Binding VerticalChannel}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="CH1" Tag="CHANnel1"/><ComboBoxItem Content="CH2" Tag="CHANnel2"/>
                                        <ComboBoxItem Content="CH3" Tag="CHANnel3"/><ComboBoxItem Content="CH4" Tag="CHANnel4"/>
                                    </ComboBox>
                                    <TextBlock Text="每格量程" Style="{DynamicResource SectionLabel}"/>
                                    <TextBox Text="{Binding VerticalScale, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="垂直偏移" Style="{DynamicResource SectionLabel}"/>
                                    <TextBox Text="{Binding VerticalOffset, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="显示通道" IsChecked="{Binding VerticalDisplayed}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Content="读取" Command="{Binding ReadVerticalCommand}" Margin="0,4,4,4"/>
                                        <Button Grid.Column="1" Content="应用" Command="{Binding ApplyVerticalCommand}"
                                                Style="{DynamicResource PrimaryButton}" Margin="4"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="日志">
                            <DataGrid ItemsSource="{Binding OperationHistory}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="75"/>
                                    <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="90"/>
                                    <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
           </Grid>
          </TabItem>
          <TabItem Header="独立波形分析">
              <ContentControl x:Name="WaveformViewHost"/>
          </TabItem>
          <TabItem Header="启动刹车测试">
              <ContentControl x:Name="AdvancedAnalysisHost"/>
          </TabItem>
          <TabItem Header="历史数据">
              <Grid Margin="24,20">
                  <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.1*"/>
                      <ColumnDefinition Width="0"/>
                      <ColumnDefinition Width="2*"/>
                  </Grid.ColumnDefinitions>
                  <Border Style="{DynamicResource CardPanel}">
                      <TabControl>
                          <TabItem Header="最近波形">
                              <DockPanel Margin="8">
                                  <StackPanel DockPanel.Dock="Bottom">
                                      <Button Content="打开选中波形" Command="{Binding OpenRecentWaveformCommand}"
                                              Style="{DynamicResource PrimaryButton}"/>
                                      <Grid>
                                          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                          <Button Content="导入旧版数据" Command="{Binding ImportLegacyCommand}" Margin="0,4,4,4"/>
                                          <Button Grid.Column="1" Content="导出当前数据" Command="{Binding ExportCsvCommand}" Margin="4"/>
                                      </Grid>
                                  </StackPanel>
                                  <ListBox ItemsSource="{Binding RecentWaveforms}" SelectedItem="{Binding SelectedRecentWaveform}"
                                           AutomationProperties.Name="最近波形列表"/>
                              </DockPanel>
                          </TabItem>
                          <TabItem Header="最近截图">
                              <DockPanel Margin="8">
                                  <StackPanel DockPanel.Dock="Bottom">
                                      <Image Source="{Binding SelectedRecentScreenshot}" MaxHeight="160"
                                             Stretch="Uniform" Margin="4"/>
                                      <Grid>
                                          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                          <Button Content="复制选中截图" Command="{Binding CopyRecentScreenshotCommand}"
                                                  Style="{DynamicResource PrimaryButton}" Margin="0,4,4,4"/>
                                          <Button Grid.Column="1" Content="打开截图目录"
                                                  Command="{Binding OpenScreenshotFolderCommand}" Margin="4"/>
                                      </Grid>
                                  </StackPanel>
                                  <ListBox ItemsSource="{Binding RecentScreenshots}"
                                           SelectedItem="{Binding SelectedRecentScreenshot}"
                                           AutomationProperties.Name="最近截图列表"/>
                              </DockPanel>
                          </TabItem>
                      </TabControl>
                  </Border>
                  <Border Grid.Column="2" Style="{DynamicResource CardPanel}">
                      <DockPanel>
                          <TextBlock DockPanel.Dock="Top" Text="操作记录" Style="{DynamicResource SectionLabel}"
                                     Foreground="{DynamicResource CyanBrush}" Margin="0,0,0,8"/>
                          <TextBox DockPanel.Dock="Top" Text="{Binding HistoryFilter, UpdateSourceTrigger=PropertyChanged}"
                                   ToolTip="按操作、详情或来源文件筛选" Margin="0,0,0,8"
                                   AutomationProperties.Name="历史记录筛选"/>
                          <DataGrid ItemsSource="{Binding FilteredOperationHistory}" IsReadOnly="True" AutoGenerateColumns="False">
                              <DataGrid.Columns>
                                  <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                                  <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="130"/>
                                  <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
                                  <DataGridTextColumn Header="来源文件" Binding="{Binding SourcePath}" Width="1.4*"/>
                              </DataGrid.Columns>
                          </DataGrid>
                      </DockPanel>
                  </Border>
              </Grid>
          </TabItem>
          <TabItem Header="AI 设置">
              <ContentControl x:Name="AiAssistantHost"/>
          </TabItem>
        </TabControl>
    </DockPanel>
</Window>

