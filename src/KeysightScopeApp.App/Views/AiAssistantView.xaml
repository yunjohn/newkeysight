<UserControl x:Class="KeysightScopeApp.App.Views.AiAssistantView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="620" MinHeight="460">
    <Grid Background="{DynamicResource BackgroundBrush}" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="520"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <TextBlock Text="AI 接口设置" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource CyanBrush}"/>
            <TextBlock Text="此处只配置 AI 服务。波形诊断请在独立波形窗口中右键选择“AI 分析波形”。"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,16"/>
            <Border Style="{DynamicResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="OpenAI-compatible 地址" Style="{DynamicResource SectionLabel}"/>
                    <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="例如：https://api.deepseek.com 或其他兼容接口地址"/>
                    <TextBlock Text="模型名称" Style="{DynamicResource SectionLabel}"/>
                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="API 密钥" Style="{DynamicResource SectionLabel}"/>
                    <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged"
                                 AutomationProperties.Name="AI API 密钥"/>
                    <TextBlock Text="超时（秒）" Style="{DynamicResource SectionLabel}"/>
                    <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="保存 AI 设置" Command="{Binding SaveSettingsCommand}"
                            Style="{DynamicResource PrimaryButton}" Margin="0,10,0,4"/>
                    <TextBlock Text="密钥使用 Windows 当前用户加密，不写入日志、CSV 或 AI 分析历史。"
                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource CyanBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
