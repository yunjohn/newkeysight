<UserControl x:Class="KeysightScopeApp.App.Views.AdvancedAnalysisView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="900" MinHeight="560">
    <DockPanel Background="{StaticResource BackgroundBrush}">
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="●" Foreground="{StaticResource GreenBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Status}" AutomationProperties.Name="分析状态"/>
        </StatusBar>

        <Border DockPanel.Dock="Top" Height="64" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="启动刹车测试" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="启动、刹车、ABZ 抖动与判定归档"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,8" VerticalAlignment="Center"
                        Background="#142AE500" BorderBrush="{StaticResource GreenBrush}"
                        BorderThickness="1" CornerRadius="3">
                    <TextBlock Text="●  分析器就绪" Foreground="{StaticResource GreenBrush}"
                               FontFamily="Microsoft YaHei UI" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <TextBlock Text="01 · 信号映射" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="控制 / 踏板" Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding ControlChannel}" ItemTemplate="{StaticResource ChannelDisplayItemTemplate}"/>
                                    <TextBlock Text="电流" Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding CurrentChannel}" ItemTemplate="{StaticResource ChannelDisplayItemTemplate}"/>
                                    <TextBlock Text="编码器 A" Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding EncoderAChannel}" ItemTemplate="{StaticResource ChannelDisplayItemTemplate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="速度" Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SpeedChannel}" ItemTemplate="{StaticResource ChannelDisplayItemTemplate}"/>
                                    <TextBlock Text="测试范围" Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding ScopeModes}" DisplayMemberPath="Value"
                                              SelectedValuePath="Key" SelectedValue="{Binding StartupScope}"/>
                                    <TextBlock Text="编码器 B" Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding EncoderBChannel}" ItemTemplate="{StaticResource ChannelDisplayItemTemplate}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorder}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="恢复推荐参数"
                                        Height="28" Padding="12,0"
                                        Command="{Binding RestoreRecommendedParametersCommand}"/>
                                <TextBlock Text="02 · 目标与限值" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,8,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="目标模式"/><ComboBox ItemsSource="{Binding TargetModes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding TargetMode}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="{Binding TargetValueLabel}"/><TextBox Text="{Binding TargetFrequencyHz}"/></StackPanel>
                                <StackPanel Margin="0,0,8,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="每转脉冲数 (脉冲/转)"/><TextBox Text="{Binding PulsesPerRevolution}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="连续周期 (个)"/><TextBox Text="{Binding ConsecutivePeriods}"/></StackPanel>
                                <StackPanel Margin="0,0,8,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="下容差 (%)"/><TextBox Text="{Binding LowerTolerancePercent}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="上容差 (%)"/><TextBox Text="{Binding UpperTolerancePercent}"/></StackPanel>
                                <StackPanel Margin="0,0,8,12"><TextBlock Text="控制边沿阈值比例 (%)"/><TextBox Text="{Binding ControlThresholdPercent}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12"><TextBlock Text="控制最小跳变 (V)"/><TextBox Text="{Binding StartupMinimumVoltageStep}"/></StackPanel>
                                <StackPanel Margin="0,0,8,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="高电平保持 (ms)"/><TextBox Text="{Binding StartupHoldMilliseconds}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="最小上升时间 (ms)"/><TextBox Text="{Binding StartupMinimumRiseMilliseconds}"/></StackPanel>
                                <StackPanel Margin="0,0,8,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="最大上升时间 (ms)"/><TextBox Text="{Binding StartupMaximumRiseMilliseconds}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="启动时限 (ms)"/><TextBox Text="{Binding StartupDelayLimitMilliseconds}"/></StackPanel>
                                <StackPanel Margin="0,0,8,12" IsEnabled="{Binding RequiresBrake}"><TextBlock Text="刹车时限 (ms)"/><TextBox Text="{Binding BrakeDelayLimitMilliseconds}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12" IsEnabled="{Binding RequiresStartup}"><TextBlock Text="启动峰值限值 (A)"/><TextBox Text="{Binding StartupPeakLimit}"/></StackPanel>
                                <StackPanel Margin="0,0,8,0" IsEnabled="{Binding RequiresBrake}"><TextBlock Text="刹车峰值限值 (A)"/><TextBox Text="{Binding BrakePeakLimit}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Expander Header="高级刹车与抖动参数" IsExpanded="False">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="刹车判据" IsEnabled="{Binding RequiresBrake}"/><ComboBox ItemsSource="{Binding BrakeModes}" SelectedItem="{Binding BrakeMode}" IsEnabled="{Binding RequiresBrake}"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,12" IsEnabled="{Binding UsesCurrentZero}"><TextBlock Text="零电流阈值 (A)"/><TextBox Text="{Binding ZeroCurrentThreshold}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12" IsEnabled="{Binding UsesCurrentZero}"><TextBlock Text="零区平坦度 (A)"/><TextBox Text="{Binding ZeroCurrentFlatThreshold}"/></StackPanel>
                                <StackPanel Margin="0,0,8,12" IsEnabled="{Binding UsesSpeedOrCurrentZero}"><TextBlock Text="零值保持 (ms)"/><TextBox Text="{Binding ZeroCurrentHoldMilliseconds}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12" IsEnabled="{Binding RequiresBrake}"><TextBlock Text="低电平保持 (ms)"/><TextBox Text="{Binding BrakeLowHoldMilliseconds}"/></StackPanel>
                                <StackPanel Margin="0,0,8,12" IsEnabled="{Binding RequiresBrake}"><TextBlock Text="最小下降时间 (ms)"/><TextBox Text="{Binding BrakeMinimumFallMilliseconds}"/></StackPanel>
                                <StackPanel Margin="8,0,0,12" IsEnabled="{Binding RequiresBrake}"><TextBlock Text="最大下降时间 (ms)"/><TextBox Text="{Binding BrakeMaximumFallMilliseconds}"/></StackPanel>
                                <StackPanel IsEnabled="{Binding UsesEncoderBacktrack}"><TextBlock Text="A相回溯脉冲 (个)"/><TextBox Text="{Binding BrakeBacktrackPulses}"/></StackPanel>
                                <StackPanel IsEnabled="{Binding UsesEncoderBacktrack}"><TextBlock Text="回溯最小跳变 (V)"/><TextBox Text="{Binding BrakeBacktrackMinimumStep}"/></StackPanel>
                                <StackPanel IsEnabled="{Binding UsesEncoderBacktrack}"><TextBlock Text="最小边沿间隔 (ms)"/><TextBox Text="{Binding BrakeBacktrackMinimumIntervalMilliseconds}"/></StackPanel>
                                <StackPanel IsEnabled="{Binding UsesEncoderBacktrack}"><TextBlock Text="编码器边沿"/><ComboBox ItemsSource="{Binding EncoderEdges}" SelectedItem="{Binding EncoderEdge}"/></StackPanel>
                                <StackPanel><TextBlock Text="AB最小间隔 (ms)"/><TextBox Text="{Binding EncoderMinimumEdgeIntervalMilliseconds}"/></StackPanel>
                                <StackPanel><TextBlock Text="抖动窗口 (ms)"/><TextBox Text="{Binding JitterWindowMilliseconds}"/></StackPanel>
                                <StackPanel><TextBlock Text="死区计数 (count)"/><TextBox Text="{Binding JitterDeadbandCounts}"/></StackPanel>
                                <StackPanel><TextBlock Text="峰峰值限值 (count)"/><TextBox Text="{Binding JitterPeakToPeakLimitCounts}"/></StackPanel>
                                <StackPanel><TextBlock Text="最少换向 (次)"/><TextBox Text="{Binding JitterMinimumReversals}"/></StackPanel>
                                <StackPanel><TextBlock Text="最短持续 (ms)"/><TextBox Text="{Binding JitterMinimumDurationMilliseconds}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource PanelBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="测试标识" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="样品" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SampleId}"/>
                                <TextBlock Grid.Column="3" Text="项目" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="4" Text="{Binding ProjectName}"/>
                                <TextBlock Grid.Column="6" Text="方案" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="7" Text="{Binding TestProfileName}"/>
                                <TextBlock Grid.Column="9" Text="版本" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="10" Text="{Binding TestProfileVersion}"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="保存方案" Command="{Binding SaveProfileCommand}"/>
                                <Button Grid.Column="2" Content="加载方案" Command="{Binding LoadProfileCommand}"/>
                                <Button Grid.Column="4" Content="加载基准" Command="{Binding LoadBaselineCommand}"/>
                                <Button Grid.Column="6" Content="比较基准" Command="{Binding CompareBaselineCommand}"/>
                                <TextBlock Grid.Column="8" Text="批量次数" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="9" Text="{Binding BatchCount}"/>
                                <Button Grid.Column="11" Content="批量运行" Command="{Binding RunBatchCommand}"/>
                                <Button Grid.Column="13" Content="取消批量" Command="{Binding CancelBatchCommand}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Width="224" Margin="16,0,0,0">
                            <Button Content="▶  执行启动刹车测试" Height="40"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AnalyzeStartupBrakeCommand}"/>
                            <Button Content="执行 ABZ 停机抖动" Command="{Binding AnalyzeJitterCommand}"/>
                            <Button Content="取消当前分析" Style="{StaticResource DangerButton}"
                                    Command="{Binding CancelAnalysisCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="2">
                    <TabItem Header="当前结果">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource PanelHighBrush}"
                                    Padding="12" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,0,0,1">
                                <WrapPanel>
                                    <Button Content="导出报告" Style="{StaticResource PrimaryButton}" Command="{Binding ExportReportCommand}"/>
                                    <Button Content="归档本次测试" Style="{StaticResource GreenButton}" Command="{Binding ArchiveCommand}"/>
                                    <Button Content="导出启动段" Command="{Binding ExportStartupSegmentCommand}"/>
                                    <Button Content="导出刹车段" Command="{Binding ExportBrakeSegmentCommand}"/>
                                </WrapPanel>
                            </Border>
                            <DataGrid ItemsSource="{Binding Results}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="指标" Binding="{Binding Name}" Width="170"/>
                                    <DataGridTextColumn Header="数值" Binding="{Binding Value}" Width="120"/>
                                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
                                    <DataGridTextColumn Header="判定" Binding="{Binding Verdict}" Width="100"/>
                                    <DataGridTextColumn Header="诊断原因" Binding="{Binding Reason}" Width="*"/>
                                    <DataGridTemplateColumn Header="波形" Width="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="定位"
                                                        Command="{Binding DataContext.NavigateResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding CanNavigate}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="测试历史">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="8">
                                <Button Content="导出全部历史" Command="{Binding ExportHistoryCommand}"/>
                                <Button Content="删除所选" Style="{StaticResource DangerButton}" Command="{Binding DeleteHistoryCommand}"/>
                                <Button Content="清空历史" Style="{StaticResource DangerButton}" Command="{Binding ClearHistoryCommand}"/>
                                <TextBlock Text="{Binding HistorySummary}" VerticalAlignment="Center"
                                           Foreground="{StaticResource CyanBrush}" Margin="12,0,0,0"/>
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      HorizontalScrollBarVisibility="Visible"
                                      VerticalScrollBarVisibility="Auto"
                                      CanUserResizeColumns="True">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader"
                                           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                    <Style TargetType="DataGridCell"
                                           BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding EffectiveGeneratedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="样品" Binding="{Binding SampleId}" Width="120" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="分析方案" Binding="{Binding ProfileName}" Width="140" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="结论" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="启动(ms)" Binding="{Binding StartupDelayMilliseconds, StringFormat={}{0:0.000}}" Width="90" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="刹车(ms)" Binding="{Binding BrakeDelayMilliseconds, StringFormat={}{0:0.000}}" Width="90" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="启动峰值" Binding="{Binding StartupPeak, StringFormat=G6}" Width="90" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="刹车峰值" Binding="{Binding BrakePeak, StringFormat=G6}" Width="90" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="平均转速" Binding="{Binding StableAverageRpm, StringFormat=G6}" Width="95" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="波动率(%)" Binding="{Binding StableFluctuationPercent, StringFormat=G6}" Width="90" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                    <DataGridTextColumn Header="运行编号" Binding="{Binding EffectiveRunId}" Width="280" ElementStyle="{StaticResource CenteredHistoryText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
