<Window x:Class="KeysightScopeApp.App.Views.AiWaveformAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 波形分析" Width="1320" Height="820" MinWidth="1050" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="AI 波形诊断" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource CyanBrush}"/>
                <TextBlock Text="AI 结论仅供工程辅助，不会修改示波器配置。" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,12"/>

                <Border Style="{DynamicResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="各通道接入信号" Style="{DynamicResource SectionLabel}"
                                   Foreground="{DynamicResource CyanBrush}"/>
                        <ItemsControl ItemsSource="{Binding ChannelSignals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Channel}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                        <TextBox Grid.Column="1" Text="{Binding SignalName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="例如：母线电压、相电流、PWM、编码器 A 相"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="简要测试描述（可选）" Style="{DynamicResource SectionLabel}" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding BriefDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                 ToolTip="可填写被测对象、位置、工况和预期表现"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="发送范围" Style="{DynamicResource SectionLabel}"
                                   Foreground="{DynamicResource CyanBrush}"/>
                        <RadioButton Content="仅发送右键时的当前窗口波形"
                                     IsChecked="{Binding CurrentViewOnly}" Margin="0,5"/>
                        <RadioButton Content="发送完整波形"
                                     IsChecked="{Binding FullWaveform}" Margin="0,5"/>
                        <TextBlock Text="{Binding DataSummary}" TextWrapping="Wrap" Margin="0,8"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Content="分析波形" Command="{Binding AnalyzeCommand}"
                                    Style="{DynamicResource PrimaryButton}" Margin="0,4,4,4"/>
                            <Button Grid.Column="1" Content="停止请求" Command="{Binding CancelCommand}" Margin="4"/>
                        </Grid>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,7,0,0"
                                   Foreground="{DynamicResource CyanBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TabControl Grid.Column="2">
            <TabItem Header="诊断概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Border Style="{DynamicResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="总体结论" Style="{DynamicResource SectionLabel}"/>
                                <TextBlock Text="{Binding Verdict}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AmberBrush}" Margin="0,4"/>
                                <TextBlock Text="{Binding Assessment}" TextWrapping="Wrap" FontSize="15" Margin="0,4"/>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6"/>
                                <TextBlock Text="{Binding Confidence, StringFormat=置信说明：{0}}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding MissingInformation, StringFormat=缺失信息：{0}}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="各通道异常与证据" Style="{DynamicResource SectionLabel}"
                                   Foreground="{DynamicResource CyanBrush}"/>
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource CardPanel}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Channel}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding Phenomenon}" TextWrapping="Wrap" Margin="0,4"/>
                                            <TextBlock Text="{Binding TimeRange, StringFormat=时间范围：{0}}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Evidence, StringFormat=量化证据：{0}}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Severity, StringFormat=严重度：{0}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="可能成因">
                <DataGrid ItemsSource="{Binding PossibleCauses}" IsReadOnly="True" AutoGenerateColumns="False" Margin="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="100"/>
                        <DataGridTextColumn Header="可能成因" Binding="{Binding Cause}" Width="*"/>
                        <DataGridTextColumn Header="可能性" Binding="{Binding Likelihood}" Width="85"/>
                        <DataGridTextColumn Header="支持证据" Binding="{Binding SupportingEvidence}" Width="1.5*"/>
                        <DataGridTextColumn Header="反证/不确定点" Binding="{Binding ContradictingEvidence}" Width="1.3*"/>
                        <DataGridTextColumn Header="验证方法" Binding="{Binding VerificationMethod}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="验证与配置建议">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="验证步骤" Style="{DynamicResource SectionLabel}" Foreground="{DynamicResource CyanBrush}"/>
                        <ItemsControl ItemsSource="{Binding VerificationSteps}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,4"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="采集配置建议" Style="{DynamicResource SectionLabel}"
                                   Foreground="{DynamicResource CyanBrush}" Margin="0,16,0,4"/>
                        <DataGrid ItemsSource="{Binding Changes}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="配置项" Binding="{Binding Setting}" Width="110"/>
                                <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="100"/>
                                <DataGridTextColumn Header="建议值" Binding="{Binding RecommendedValue}" Width="100"/>
                                <DataGridTextColumn Header="理由" Binding="{Binding Reason}" Width="2*"/>
                                <DataGridTextColumn Header="风险" Binding="{Binding Risk}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,4,16,0">
            <Button Content="复制分析结果" Command="{Binding CopyCommand}" Padding="14,7"/>
            <Button Content="保存分析记录" Command="{Binding SaveRecordCommand}" Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
